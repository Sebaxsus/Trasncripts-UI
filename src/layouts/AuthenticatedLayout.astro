---
import BaseLayout from './BaseLayout.astro';
import { RadioPlayer } from '../components/RadioPlayer';
import { ServerStatusPill } from '../components/ServerStatusPill';
import { ToastContainer } from '../components/ToastContainer';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<BaseLayout title={title}>
  <style>
    /*
      Guard de auth: main arranca oculto por defecto (no depende de que el
      script llegue a tiempo) y solo se revela si hasToken() es true. Se usa
      este enfoque de CSS + script externo en vez de un <script> inline
      bloqueante porque la CSP de producción exige script-src 'self' — un
      inline síncrono forzaría 'unsafe-inline', debilitando esa protección
      para todo el sitio por un beneficio menor de UX.
    */
    main {
      visibility: hidden;
      /* espacio para que la barra fija del RadioPlayer no tape contenido */
      padding-bottom: 4rem;
    }
    main.auth-ok {
      visibility: visible;
    }
    /*
      El footer vive en BaseLayout.astro, no en este archivo — el scoping de
      Astro (que solo alcanza elementos escritos literalmente acá) no lo cubre,
      hace falta :global(). Mismo motivo que el padding-bottom de main: RadioPlayer
      es fixed inset-x-0 bottom-0, y sin esto tapa el footer al hacer scroll.
    */
    :global(footer) {
      padding-bottom: 4rem;
    }
  </style>
  <nav class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
    <a href="/dashboard" class="font-semibold text-slate-900">Transcripciones</a>
    <div class="flex items-center gap-4">
      <ServerStatusPill client:load transition:persist="server-status-pill" />
      <button id="logout-button" class="text-sm text-slate-600 hover:text-slate-900">Cerrar sesión</button>
    </div>
  </nav>
  <main>
    <slot />
  </main>
  <RadioPlayer client:load transition:persist="radio-player" />
  <ToastContainer client:load transition:persist="toast-container" />
</BaseLayout>

<script>
  import { hasToken, clearToken } from '../lib/auth';

  const main = document.querySelector('main');

  if (!hasToken()) {
    window.location.replace('/login');
  } else {
    main?.classList.add('auth-ok');
  }

  document.getElementById('logout-button')?.addEventListener('click', () => {
    clearToken();
    window.location.href = '/login';
  });
</script>
