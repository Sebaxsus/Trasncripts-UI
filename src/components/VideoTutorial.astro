---
interface Props {
  // Pegar acá el ID del video de YouTube cuando exista (ej. "dQw4w9WgXcQ").
  // Si se agrega un iframe real de YouTube, también hay que sumar
  // frame-src https://www.youtube-nocookie.com a la CSP en src/middleware.ts.
  youtubeId?: string;
}

const { youtubeId = '' } = Astro.props;
---

<div class="aspect-video w-full overflow-hidden rounded-lg border border-slate-200 bg-slate-50">
  {
    youtubeId ? (
      <iframe
        class="h-full w-full"
        src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
        title="Tutorial de uso"
        allowfullscreen
      />
    ) : (
      <div class="flex h-full items-center justify-center text-sm text-slate-400">
        Video tutorial próximamente
      </div>
    )
  }
</div>
